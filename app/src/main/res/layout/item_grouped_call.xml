<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Call info row (tappable to expand actions) -->
    <LinearLayout
        android:id="@+id/grouped_call_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="@dimen/medium_margin"
        android:paddingBottom="@dimen/medium_margin"
        android:paddingStart="@dimen/normal_margin"
        android:paddingEnd="@dimen/normal_margin">

        <ImageView
            android:id="@+id/grouped_call_type"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:alpha="0.6"
            android:src="@drawable/ic_incoming_call_vector" />

        <TextView
            android:id="@+id/grouped_call_date_time"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/small_margin"
            android:ellipsize="end"
            android:maxLines="1"
            android:textSize="@dimen/bigger_text_size"
            tools:text="14:15" />

        <TextView
            android:id="@+id/grouped_call_duration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/small_margin"
            android:alpha="0.6"
            android:textSize="@dimen/normal_text_size"
            tools:text="00:37" />

        <ImageView
            android:id="@+id/grouped_call_indicator"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:alpha="0.4"
            android:rotation="0"
            android:src="@drawable/ic_chevron_right_vector" />

    </LinearLayout>

    <!-- Expandable actions panel -->
    <LinearLayout
        android:id="@+id/grouped_call_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:background="?android:attr/colorBackgroundFloating"
        android:paddingStart="@dimen/big_margin"
        android:paddingEnd="@dimen/normal_margin">

        <!-- Play recording -->
        <LinearLayout
            android:id="@+id/action_play_recording"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/activity_margin"
            android:paddingBottom="@dimen/activity_margin"
            android:visibility="gone">

            <ImageView
                android:id="@+id/action_play_recording_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_play_arrow_vector" />

            <TextView
                android:id="@+id/action_play_recording_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/normal_margin"
                android:text="@string/play_recording"
                android:textSize="@dimen/normal_text_size" />
        </LinearLayout>

        <!-- Share recording -->
        <LinearLayout
            android:id="@+id/action_share_recording"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/activity_margin"
            android:paddingBottom="@dimen/activity_margin"
            android:visibility="gone">

            <ImageView
                android:id="@+id/action_share_recording_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_share_vector" />

            <TextView
                android:id="@+id/action_share_recording_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/normal_margin"
                android:text="@string/share_recording"
                android:textSize="@dimen/normal_text_size" />
        </LinearLayout>

        <!-- Transcribe -->
        <LinearLayout
            android:id="@+id/action_transcribe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/activity_margin"
            android:paddingBottom="@dimen/activity_margin"
            android:visibility="gone">

            <ImageView
                android:id="@+id/action_transcribe_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_description_vector" />

            <TextView
                android:id="@+id/action_transcribe_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/normal_margin"
                android:text="@string/transcribe_recording"
                android:textSize="@dimen/normal_text_size" />
        </LinearLayout>

        <!-- Show transcription -->
        <LinearLayout
            android:id="@+id/action_show_transcription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/activity_margin"
            android:paddingBottom="@dimen/activity_margin"
            android:visibility="gone">

            <ImageView
                android:id="@+id/action_show_transcription_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_description_vector" />

            <TextView
                android:id="@+id/action_show_transcription_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/normal_margin"
                android:text="@string/show_transcription"
                android:textSize="@dimen/normal_text_size" />
        </LinearLayout>

        <!-- Share transcription -->
        <LinearLayout
            android:id="@+id/action_share_transcription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingTop="@dimen/activity_margin"
            android:paddingBottom="@dimen/activity_margin"
            android:visibility="gone">

            <ImageView
                android:id="@+id/action_share_transcription_icon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_share_vector" />

            <TextView
                android:id="@+id/action_share_transcription_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/normal_margin"
                android:text="@string/share_transcription"
                android:textSize="@dimen/normal_text_size" />
        </LinearLayout>

        <!-- Inline transcription viewer -->
        <LinearLayout
            android:id="@+id/action_transcription_viewer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:paddingTop="@dimen/small_margin">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?android:attr/listDivider" />

            <TextView
                android:id="@+id/action_transcription_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:text="@string/transcription_dialog_title_generic"
                android:textSize="@dimen/normal_text_size"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/small_margin"
                android:layout_marginBottom="@dimen/small_margin"
                android:fillViewport="true">

                <TextView
                    android:id="@+id/action_transcription_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/normal_text_size"
                    android:textIsSelectable="true"
                    android:lineSpacingMultiplier="1.3"
                    android:maxLines="20" />
            </ScrollView>

            <LinearLayout
                android:id="@+id/action_copy_transcription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingTop="@dimen/small_margin"
                android:paddingBottom="@dimen/activity_margin">

                <ImageView
                    android:id="@+id/action_copy_transcription_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_copy_vector" />

                <TextView
                    android:id="@+id/action_copy_transcription_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/normal_margin"
                    android:text="@string/copy_text"
                    android:textSize="@dimen/normal_text_size" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="@dimen/normal_margin"
        android:layout_marginEnd="@dimen/normal_margin"
        android:background="?android:attr/listDivider" />

</LinearLayout>
