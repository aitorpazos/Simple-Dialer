<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Reuse the real call layout -->
    <include
        android:id="@+id/call_screen"
        layout="@layout/activity_call"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Simulated call banner overlay -->
    <TextView
        android:id="@+id/simulated_banner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="4dp"
        android:background="@drawable/pill_background"
        android:backgroundTint="#88FF5722"
        android:elevation="8dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="4dp"
        android:text="@string/simulated_call_banner"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

</FrameLayout>
